<mxfile host="app.diagrams.net" type="device"><diagram name="C4 Container - управление учётными данными" id="C4-Container---управление-учётными-данными"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="country" value="Страна представительства (RU | KZ | EU ...) - все персональные, медицинские и авторизационные данные хранятся внутри границы" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="1180" height="920" as="geometry"/></mxCell><mxCell id="pilot" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;владелец протеза, смотрит отчёты, донастраивает протез&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="180" height="120" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Оператор / сотрудник&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;продажи, производство, CRM&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1520" y="720" width="200" height="110" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;Приложение отчётов / донастройки&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[React SPA, Android/iOS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;НЕ видит токенов IdP: только HttpOnly session cookie&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="210" height="120" as="geometry"/></mxCell><mxCell id="bff" value="&lt;b&gt;Auth BFF (Backend-for-Frontend)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[confidential OAuth2-client, API gateway]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Authorization Code + PKCE; хранит access/refresh server-side; проксирует /api/* и подставляет Bearer&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="340" width="230" height="130" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Session store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Redis, в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;session_id -&amp;gt; access/refresh token, TTL = refresh lifetime&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="210" height="100" as="geometry"/></mxCell><mxCell id="kc" value="&lt;b&gt;Keycloak (экземпляр страны)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[IdP: OIDC / SAML, realm на страну]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Code + PKCE, Identity Brokering, User Federation, RBAC-роли (prothetic_user ...)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="320" width="250" height="140" as="geometry"/></mxCell><mxCell id="kcdb" value="&lt;b&gt;Keycloak DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL, в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;сессии, роли, связки с внешними IdP, минимальный профиль&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="230" height="100" as="geometry"/></mxCell><mxCell id="ldap" value="&lt;b&gt;Локальный источник учётных записей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[LDAP / HR-система страны]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;User Federation: проверка пароля и атрибутов на месте, import users = off&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="250" height="120" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;reports-api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[FastAPI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;валидирует JWT по JWKS (iss, aud, exp, роль), отчёт только о себе&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="230" height="110" as="geometry"/></mxCell><mxCell id="crm" value="&lt;b&gt;CRM / Интернет-магазин&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[существующие системы]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SSO через тот же Keycloak (OIDC)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="220" height="110" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Данные протезов и клиентов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL, ClickHouse, в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;телеметрия, CRM, витрина отчётов&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="250" height="100" as="geometry"/></mxCell><mxCell id="note" value="Схема токенов:&lt;br&gt;1. SPA -&amp;gt; BFF /login; BFF формирует code_verifier/code_challenge и редиректит в Keycloak.&lt;br&gt;2. Keycloak аутентифицирует пилота: локально (LDAP/HR) или через внешний IdP (brokering).&lt;br&gt;3. BFF получает code -&amp;gt; /token с code_verifier + client_secret; access/refresh кладёт в Redis.&lt;br&gt;4. SPA получает только непрозрачный session_id в HttpOnly/Secure/SameSite cookie.&lt;br&gt;5. Вызовы /api/* идут через BFF, который подставляет Bearer и сам обновляет токен по refresh.&lt;br&gt;XSS во фронтенде не даёт злоумышленнику токенов; утечка code без verifier бесполезна (PKCE).&lt;br&gt;Границы данных: на страну свой Keycloak + каталог + БД; между странами нет репликации ПДн,&lt;br&gt;только федерация идентичности по OIDC при необходимости." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="540" height="230" as="geometry"/></mxCell><mxCell id="esia" value="&lt;b&gt;Госуслуги / ЕСИА&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешний IdP, RU]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OIDC&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="100" width="220" height="80" as="geometry"/></mxCell><mxCell id="egov" value="&lt;b&gt;eGov.kz / НУЦ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешний IdP, KZ]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OIDC / SAML&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="240" width="220" height="80" as="geometry"/></mxCell><mxCell id="eidas" value="&lt;b&gt;eIDAS-узел / национальный eID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешний IdP, EU]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SAML 2.0&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="380" width="220" height="80" as="geometry"/></mxCell><mxCell id="social" value="&lt;b&gt;Google / Apple ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешний IdP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OIDC&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="520" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pilot" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS, SSO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="operator" target="crm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="/login, /api/* + session cookie (HttpOnly, Secure, SameSite=Lax)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="spa" target="bff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="OIDC Authorization Code + PKCE, client_secret; /token, refresh; back-channel logout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bff" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="tokens по session_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bff" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Bearer access_token (aud=reports-api)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bff" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kc" target="kcdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="LDAP bind / HR API: аутентификация и атрибуты по запросу, без копирования" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kc" target="ldap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Identity Brokering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="kc" target="esia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Identity Brokering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="kc" target="egov"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Identity Brokering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="kc" target="eidas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Identity Brokering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="kc" target="social"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="OIDC SSO (confidential client)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="crm" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="JWKS: проверка подписи токена" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="api" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="SQL, только строки пользователя" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="data"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>