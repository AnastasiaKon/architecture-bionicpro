<mxfile host="app.diagrams.net" type="device"><diagram name="C4 Container - сервис отчётов" id="C4-Container---сервис-отчётов"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bionic" value="BionicPRO" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="1320" height="900" as="geometry"/></mxCell><mxCell id="etl" value="Аналитический контур (OLAP)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="740" height="480" as="geometry"/></mxCell><mxCell id="pilot" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;хочет скачать отчёт о работе своего протеза&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="180" height="120" as="geometry"/></mxCell><mxCell id="chip" value="&lt;b&gt;Программа в чипе протеза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[C++, ESP32, 4G]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;распознаёт движения, шлёт телеметрию&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="180" height="110" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;Приложение отчётов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[React SPA + keycloak-js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;логин через Code + PKCE, кнопка «Generate report», выбор периода, скачивание CSV&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="220" height="120" as="geometry"/></mxCell><mxCell id="kc" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[IdP, realm reports-realm]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;клиент reports-frontend (PKCE S256), audience reports-api, роль prothetic_user&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="220" height="120" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;reports-api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[FastAPI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GET /reports: JWT -&amp;gt; username -&amp;gt; витрина; 401/403/422; только своё&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="230" height="120" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;API телеметрии&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[существующий бэкенд]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;принимает события с чипов по 4G&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="220" height="100" as="geometry"/></mxCell><mxCell id="tdb" value="&lt;b&gt;База телеметрии&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL, схема telemetry]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;сырой поток событий, индекс по event_ts&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="760" width="220" height="100" as="geometry"/></mxCell><mxCell id="crm" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[существующая система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;клиенты и их протезы&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="560" width="170" height="100" as="geometry"/></mxCell><mxCell id="crmdb" value="&lt;b&gt;CRM DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL, схема crm]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;customers, prostheses (username = Keycloak login)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="760" width="170" height="110" as="geometry"/></mxCell><mxCell id="airflow" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[scheduler + webserver, LocalExecutor]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DAG bionicpro_reports_etl, каждый час: load_crm, load_telemetry (инкремент по водяному знаку), build_report_mart, update_watermark&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="480" width="280" height="150" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[OLAP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;raw_telemetry_events, crm_*, ВИТРИНА prosthesis_usage_report (ORDER BY username, report_date), etl_watermark&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="480" width="310" height="150" as="geometry"/></mxCell><mxCell id="afdb" value="&lt;b&gt;Airflow metadata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;состояние DAG-ов&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="760" width="280" height="80" as="geometry"/></mxCell><mxCell id="note" value="Поток отчёта: SPA -&amp;gt; reports-api с Bearer (aud=reports-api). API проверяет подпись по JWKS,&lt;br&gt;iss/aud/exp и роль prothetic_user, берёт preferred_username из токена (не из запроса)&lt;br&gt;и читает готовые агрегаты по узкому диапазону ключа. Никаких вычислений в реальном времени.&lt;br&gt;Период обрезается до etl_watermark.processed_until; целиком необработанный период -&amp;gt; 422." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="580" height="130" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pilot" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="OIDC Authorization Code + PKCE (S256)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="spa" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="GET /reports?date_from&amp;date_to, Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="spa" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="JWKS (кэш 10 мин)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="api" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SELECT ... FROM prosthesis_usage_report FINAL WHERE username = ?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="телеметрия, 4G, realtime" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="chip" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="INSERT events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ingest" target="tdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="crm" target="crmdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="extract: event_ts в [watermark, interval_end)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="airflow" target="tdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="extract: полный снимок customers, prostheses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="airflow" target="crmdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="insert raw/crm; INSERT ... SELECT агрегаты в витрину; watermark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="airflow" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="airflow" target="afdb"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>